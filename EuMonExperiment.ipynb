       "  'rel': 'download',\n",
       "  'type': None,\n",
       "  'hreflang': None,\n",
       "  'title': 'Download 9a53ac77-3f3a-4e41-bb72-7be4a814c4f4/output/TAN_WT_S3A_20180211T062446.tif'},\n",
       " {'href': 'https://insula.earth/secure/api/v2.0/platformFiles/93909{?projection}/dl',\n",
       "  'rel': 'download',\n",
       "  'type': None,\n",
       "  'hreflang': None,\n",
       "  'title': 'Download 9a53ac77-3f3a-4e41-bb72-7be4a814c4f4/output/TAN_CHL_S3A_20180211T062446.tif'}]"
      ]
     },
     "execution_count": 29,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
