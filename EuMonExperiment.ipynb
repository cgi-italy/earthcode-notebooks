       "   'title': 'Process Execution'},\n",
       "  {'href': 'http://eopaas-server:8090/secure/api/v2.0/jobs/32772',\n",
       "   'rel': 'job',\n",
       "   'type': None,\n",
       "   'hreflang': None,\n",
       "   'title': 'Job'}]}"
      ]
     },
     "execution_count": 19,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "run_request_dict"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e88c088c-0339-4999-bdd6-accedff61fce",
   "metadata": {},
   "source": [
    "## Check the job status\n",
    "Query the job endpoint using the `id` returned above. The response reports\n",
    "the current state of the job (e.g. running, successful, or failed). Re-run\n",
    "this cell to refresh the status until the job has finished."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "322e116b-db75-4c3b-82dc-ae819f22c9f4",
   "metadata": {
    "editable": true,
    "slideshow": {
     "slide_type": ""
    },
    "tags": []
   },
   "outputs": [],
   "source": [
    "job_id=run_request_dict['id']\n",
    "HEADERS={'Authorization': f'Apikey {API_KEY}'}\n",
    "\n",
    "status_url = f\"{BASE_URL}/ogcapi/jobs/{job_id}\"\n",
    "status = requests.get(status_url, headers=HEADERS)\n",
    "status_dict = json.loads(status.text)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "5b44ec6d-430c-4c3f-a59f-04000a50fb79",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "{'title': 'Eumon',\n",
