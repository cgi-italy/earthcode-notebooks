    "outputs_dict"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e254e7a4-271a-4e8a-8561-9d4d3ccd5ed8",
   "metadata": {},
   "source": [
    "## Download the output files\n",
    "Iterate over the result entries and download each file into a local\n",
    "`downloads/` folder. Each `href` contains a `{?projection}` URI-template\n",
    "placeholder, which is stripped out before the request. Files are streamed to\n",
    "disk in chunks so large GeoTIFFs are not held entirely in memory, and the\n",
    "readable file name is taken from the entry's `title`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "e9a0f37c-3d74-4012-bcd3-7b4db205a502",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Downloading TAN_SPM_S3A_20180211T062446.tif ...\n",
      "  saved to downloads/TAN_SPM_S3A_20180211T062446.tif\n",
      "Downloading TAN_TUR_S3A_20180211T062446.tif ...\n",
      "  saved to downloads/TAN_TUR_S3A_20180211T062446.tif\n",
      "Downloading TAN_WT_S3A_20180211T062446.tif ...\n",
      "  saved to downloads/TAN_WT_S3A_20180211T062446.tif\n",
      "Downloading TAN_CHL_S3A_20180211T062446.tif ...\n",
      "  saved to downloads/TAN_CHL_S3A_20180211T062446.tif\n",
      "Done.\n"
     ]
    }
   ],
   "source": [
    "download_dir = \"downloads\"\n",
    "os.makedirs(download_dir, exist_ok=True)\n",
    "\n",
    "for item in outputs_dict:\n",
    "    # Remove any {...} URI-template placeholders, e.g. {?projection}\n",
    "    href = re.sub(r'\\{[^}]*\\}', '', item['href'])\n",
    "\n",
    "    # Derive a filename from the title (last path segment)\n",
    "    filename = item['title'].split('/')[-1]\n",
    "    filepath = os.path.join(download_dir, filename)\n",
    "\n",
    "    print(f\"Downloading {filename} ...\")\n",
    "    with requests.get(href, headers=HEADERS, stream=True, verify=True) as r:\n",
    "        r.raise_for_status()\n",
    "        with open(filepath, 'wb') as f:\n",
    "            for chunk in r.iter_content(chunk_size=8192):\n",
    "                f.write(chunk)\n",
    "\n",
    "    print(f\"  saved to {filepath}\")\n",
    "\n",
    "print(\"Done.\")"
   ]
  },
