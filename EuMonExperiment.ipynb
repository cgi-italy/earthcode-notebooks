    "status_dict"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c102a2f9-c28c-4ac7-80c1-390e69018245",
   "metadata": {},
   "source": [
    "## Retrieve the result links\n",
    "Once the job has completed successfully, request its results. The response is\n",
    "a list of output entries, each with a download `href` and a `title` that\n",
    "includes the output file name."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "805580ca-cc03-44e8-8f7d-070a4cedc4fa",
   "metadata": {
    "editable": true,
    "slideshow": {
     "slide_type": ""
    },
    "tags": []
   },
   "outputs": [],
   "source": [
    "outputs_url = f\"{BASE_URL}/ogcapi/jobs/{job_id}/results/output\"\n",
    "outputs = requests.get(outputs_url, headers=HEADERS)\n",
    "outputs_dict = json.loads(outputs.text)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "fa8499df-91b1-4be6-acc1-cc031e5203c5",
   "metadata": {},
   "outputs": [
